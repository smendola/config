#!/usr/bin/env python3
# OC:CUDA-LINUX:sal:ses_de12803ecffePF1j9OvOap8b0K JSONC-safe model sync.
"""Sync llama-server model presets into opencode.jsonc and dsh cordis.patch.yml."""

import json
import re
import sys
from pathlib import Path

import yaml

PRESET_PATH = Path.home() / ".config/llama.cpp/models-preset.ini"
OPENCODE_PATH = Path.home() / ".config/opencode/opencode.jsonc"
DSH_PATH = Path.home() / ".dsh/profiles/web/cordis.patch.yml"
DEFAULT_OUTPUT = 8192


def jsonc_text(text):
    """Mask comments and trailing commas, preserving offsets for targeted edits."""
    tokens = r'"(?:\\.|[^"\\])*"|//[^\r\n]*|/\*[\s\S]*?\*/'
    cleaned = re.sub(
        tokens,
        lambda m: m[0] if m[0].startswith('"') else re.sub(r"[^\r\n]", " ", m[0]),
        text,
    )
    return re.sub(
        r'"(?:\\.|[^"\\])*"|,(?=\s*[}\]])',
        lambda m: " " if m[0] == "," else m[0],
        cleaned,
    )


def replace_jsonc_member(text, path, value):
    """Replace an existing member without reserializing unrelated config."""
    cleaned = jsonc_text(text)
    decoder = json.JSONDecoder()

    def skip_space(pos):
        while pos < len(cleaned) and cleaned[pos].isspace():
            pos += 1
        return pos

    pos = skip_space(0)
    for depth, member in enumerate(path):
        if cleaned[pos] != "{":
            raise ValueError(f"Expected object at {path[:depth]}")
        pos = skip_space(pos + 1)
        while cleaned[pos] != "}":
            key, end = decoder.raw_decode(cleaned, pos)
            colon = skip_space(end)
            if cleaned[colon] != ":":
                raise ValueError("Expected colon after object key")
            start = skip_space(colon + 1)
            _, end = decoder.raw_decode(cleaned, start)
            if key == member:
                if depth == len(path) - 1:
                    line_start = text.rfind("\n", 0, pos) + 1
                    indent = re.match(r"[ \t]*", text[line_start:pos])[0]
                    replacement = json.dumps(value, indent=2, ensure_ascii=False)
                    replacement = replacement.replace("\n", "\n" + indent)
                    return text[:start] + replacement + text[end:]
                pos = start
                break
            pos = skip_space(end)
            if cleaned[pos] == ",":
                pos = skip_space(pos + 1)
        else:
            raise KeyError(member)
    raise ValueError("Empty member path")


def parse_ini(path):
    """Parse a simple INI file without interpolation, returning {section: {key: value}}."""
    sections = {}
    current = None
    for line in path.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith(("#", ";")):
            continue
        if line.startswith("[") and line.endswith("]"):
            current = line[1:-1]
            sections[current] = {}
        elif "=" in line and current is not None:
            k, _, v = line.partition("=")
            sections[current][k.strip()] = v.strip()
    return sections


def ctx_label(ctx):
    return f"{ctx // 1000}k"


def auto_name(key, ctx):
    return f"{key.replace('-', ' ').title()} [{ctx_label(ctx)}]"


class DshDumper(yaml.SafeDumper):
    def increase_indent(self, flow=False, indentless=False):
        return super().increase_indent(flow, False)


def is_vision(values):
    return bool(values.get("mmproj"))


def update_dsh(presets):
    text = DSH_PATH.read_text()
    entries = yaml.safe_load(text)

    header = ""
    for line in text.splitlines(keepends=True):
        if line.startswith("#"):
            header += line
        elif line.strip():
            break

    entry = next(e for e in entries if e.get("id") == "llm-pi-ai")
    provider = entry["config"]["providers"]["cuda-linux-llama"]
    existing = {m["id"]: m for m in provider.get("models", [])}

    models = []
    for section, values in presets.items():
        ctx = int(values.get("ctx-size", 4096))
        merged = dict(existing.get(section, {}))
        merged["id"] = section
        merged["name"] = auto_name(section, ctx)
        merged["contextWindow"] = ctx
        merged["input"] = ["text"] + (["image"] if is_vision(values) else [])
        models.append(merged)

    provider["models"] = models
    DSH_PATH.write_text(
        header + yaml.dump(
            entries, Dumper=DshDumper, sort_keys=False, allow_unicode=True
        )
    )
    print(f"Updated {DSH_PATH}.")


def main():
    if not PRESET_PATH.exists():
        sys.exit(f"Preset file not found: {PRESET_PATH}")
    if not OPENCODE_PATH.exists():
        sys.exit(f"opencode.jsonc not found: {OPENCODE_PATH}")
    if not DSH_PATH.exists():
        sys.exit(f"dsh patch file not found: {DSH_PATH}")

    presets = parse_ini(PRESET_PATH)
    config_text = OPENCODE_PATH.read_text()
    config = json.loads(jsonc_text(config_text))

    existing_models = config["provider"]["llama-server"].get("models", {})

    models = {}
    for section, values in presets.items():
        ctx = int(values.get("ctx-size", 4096))
        name = auto_name(section, ctx)
        # Preserve any extra settings (e.g. "interleaved") already present
        # for this model; only overwrite the fields we manage.
        merged = dict(existing_models.get(section, {}))
        if is_vision(values):
            merged["name"] = name.replace(" [", " 👁️‍🗨️ [")
        else:
            merged["name"] = name
        merged["limit"] = {"context": ctx, "output": DEFAULT_OUTPUT}
        if is_vision(values):
            merged["attachment"] = True
            merged["modalities"] = {"input": ["text", "image"], "output": ["text"]}
        else:
            merged.pop("attachment", None)
            merged.pop("modalities", None)
        models[section] = merged
        print(f"* {name}")

    # Replace the provider when models is absent, retaining support for new configs.
    path = ["provider", "llama-server"]
    if "models" in config["provider"]["llama-server"]:
        path.append("models")
        replacement = models
    else:
        replacement = {**config["provider"]["llama-server"], "models": models}
    OPENCODE_PATH.write_text(replace_jsonc_member(config_text, path, replacement))
    print(f"Updated {OPENCODE_PATH}.")

    update_dsh(presets)


if __name__ == "__main__":
    main()
