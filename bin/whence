#!/bin/bash

if [[ -z "$1" || $1 = -* ]]; then
    echo "Usage: whence <command>"
    exit 1
fi

cmd="$1"

if ! command -v "$cmd" &>/dev/null; then
    echo "Warning: '$cmd' not found on PATH" >&2
fi

# Check snap first (by name)
if snap list "$cmd" &>/dev/null; then
    echo "snap install $cmd"
    exit 0
fi

# Check cargo (before PATH lookup, since ~/.cargo/bin may not be in PATH)
if [ -f "$HOME/.cargo/bin/$cmd" ]; then
    pkg=$(cargo install --list 2>/dev/null | grep -B1 "$HOME/.cargo/bin/$cmd" | head -1 | awk '{print $1}')
    [ -z "$pkg" ] && pkg="$cmd"
    echo "cargo install $pkg"
    exit 0
fi

cmd_path=$(command -v "$cmd" 2>/dev/null)

if [ -z "$cmd_path" ]; then
    echo "Unable to determine"
    exit 1
fi

real_path=$(readlink -f "$cmd_path")

# Check snap (by path)
if [[ "$cmd_path" == /snap/* ]]; then
    pkg=$(echo "$cmd_path" | cut -d'/' -f4)
    echo "snap install $pkg"
    exit 0
fi

# Check flatpak
if [[ "$cmd_path" == *flatpak* ]]; then
    pkg=$(flatpak list --app --columns=application,name 2>/dev/null | grep -i "$cmd" | head -1 | awk '{print $1}')
    if [ -n "$pkg" ]; then
        echo "flatpak install $pkg"
        exit 0
    fi
fi

# Check brew
if [[ "$cmd_path" == */homebrew/* || "$cmd_path" == */linuxbrew/* ]]; then
    pkg=$(brew list --formula 2>/dev/null | grep -x "$cmd")
    [ -z "$pkg" ] && pkg="$cmd"
    echo "brew install $pkg"
    exit 0
fi

# Check npm global
if npm_root=$(npm root -g 2>/dev/null); then
    if [[ "$real_path" == "$npm_root"/* ]]; then
        pkg=${real_path#"$npm_root"/}
        if [[ "$pkg" == @*/* ]]; then
            pkg=$(echo "$pkg" | cut -d'/' -f1-2)
        else
            pkg=${pkg%%/*}
        fi
        echo "npm install -g $pkg"
        exit 0
    fi
fi

if npm list -g --depth=0 --parseable 2>/dev/null | grep -q "/$cmd$"; then
    echo "npm install -g $cmd"
    exit 0
fi

# Check apt (resolve symlinks)
pkg=$(dpkg -S "$real_path" 2>/dev/null | cut -d':' -f1)
if [ -n "$pkg" ]; then
    # Try to find the source repo
    origin=$(apt-cache policy "$pkg" 2>/dev/null \
        | awk '/\*\*\*/{found=1} found && /http/{print $2; exit}')
    if [ -n "$origin" ]; then
        echo "# source: $origin"
    else
        echo "# source: manually installed (no apt repo)"
    fi
    echo "apt install $pkg"
    exit 0
fi

echo "Unable to determine"
