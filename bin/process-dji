#!/usr/bin/env bash
# Generate 10-bit H.265 and AV1, retaining each DJI original's color information.
# Outputs are relative to the current working directory. No audio is retained.
# Usage: process-dji [--delete] [-v h265|av1|both] FILE_OR_FOLDER [FILE_OR_FOLDER...]
# Folder arguments expand to immediate MP4, JPG and DNG files (not recursive).
# JPG and DNG files are copied with timestamps preserved.
# Requirements: ffmpeg with hevc_nvenc, av1_nvenc, scale_cuda, and an
# AV1-capable NVIDIA GPU with a compatible driver.

set -euo pipefail

color_line() {
    local COLOR="$1"
    shift
    if [[ -t 1 ]]; then
        printf '\033[%sm%s\033[0m\n' "$COLOR" "$*"
    else
        printf '%s\n' "$*"
    fi
}

# NVENC quality: lower CQ = better quality / larger files (not x265 CRF).
H265_CQ=20
H265_PRESET="p5"
CQ=20
AV1_PRESET="p5"

usage() {
    echo "Usage: $(basename "$0") [--delete] [-v h265|av1|both] FILE_OR_FOLDER [FILE_OR_FOLDER...]"
    echo ""
    echo "Converts DJI videos to both 10-bit H.265 and AV1 using CUDA/NVENC."
    echo "Preserves resolution, frame rate, and source color information; omits audio."
    echo "Folder arguments include immediate MP4, JPG and DNG files (not recursive)."
    echo "JPG and DNG files are copied, preserving timestamps; originals stay in place."
    echo "--delete: move JPG/DNG files and delete videos after all selected encodes succeed."
    echo "Skipped outputs retain their originals, even with --delete."
    echo ""
    echo "Outputs relative to the current working directory:"
    echo "  ./H265/<original_name>_h265.MP4"
    echo "  ./AV1/<original_name>_av1.MP4"
    echo "  ./JPG/<original_filename>"
    echo "  ./DNG/<original_filename>"
    echo "Existing output files are skipped."
}

VIDEO_FORMAT=both
DELETE_ORIGINALS=false
ARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --delete) DELETE_ORIGINALS=true; shift ;;
        -v|-v?*)
            if [[ "$1" == -v ]]; then
                if [[ $# -lt 2 ]]; then
                    echo "Option -v requires an argument." >&2
                    exit 1
                fi
                VALUE="$2"
                shift 2
            else
                VALUE="${1#-v}"
                shift
            fi
            case "$VALUE" in
                h265|av1|both) VIDEO_FORMAT="$VALUE" ;;
                *) echo "Invalid video format: $VALUE (expected h265, av1 or both)" >&2; exit 1 ;;
            esac
            ;;
        --) shift; ARGS+=("$@"); break ;;
        -*) echo "Unknown option: $1" >&2; exit 1 ;;
        *) ARGS+=("$1"); shift ;;
    esac
done
set -- "${ARGS[@]}"

if [[ $# -eq 0 ]]; then
    usage
    exit 1
fi

case "$VIDEO_FORMAT" in
    both) FORMATS=(h265 av1) ;;
    *) FORMATS=("$VIDEO_FORMAT") ;;
esac
for FORMAT in "${FORMATS[@]}"; do
    mkdir -p "./${FORMAT^^}"
done

TEMP_DIR=""
cleanup() {
    if [[ -n "$TEMP_DIR" ]]; then
        rm -rf -- "$TEMP_DIR"
    fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
STATUS=0

shopt -s nullglob
INPUTS=()
for ARG in "$@"; do
    if [[ -d "$ARG" ]]; then
        FILES=()
        for FILE in "$ARG"/*.[mM][pP]4 "$ARG"/*.[jJ][pP][gG] "$ARG"/*.[dD][nN][gG]; do
            [[ -f "$FILE" ]] && FILES+=("$FILE")
        done
        if [[ ${#FILES[@]} -eq 0 ]]; then
            color_line 33 "⚠  No MP4, JPG or DNG files in folder: $ARG"
        fi
        INPUTS+=("${FILES[@]}")
    else
        INPUTS+=("$ARG")
    fi
done

for INPUT in "${INPUTS[@]}"; do
    if [[ ! -f "$INPUT" ]]; then
        color_line 33 "⚠  Skipping (not a file): $INPUT"
        STATUS=1
        continue
    fi

    BASE="$(basename "$INPUT")"
    NAME="${BASE%.*}"
    EXT="${BASE##*.}"

    case "${EXT^^}" in
        JPG|DNG)
            OUTPUT_DIR="./${EXT^^}"
            OUTPUT="${OUTPUT_DIR}/${BASE}"
            mkdir -p "$OUTPUT_DIR"
            if [[ -e "$OUTPUT" ]]; then
                color_line 33 "⚠  Output already exists, skipping: $OUTPUT"
            elif [[ "$DELETE_ORIGINALS" == true ]]; then
                if mv -n -- "$INPUT" "$OUTPUT" && [[ ! -e "$INPUT" && ! -L "$INPUT" ]]; then
                    color_line 32 "✔  Moved: $INPUT → $OUTPUT"
                else
                    color_line 31 "✘  Move failed or skipped: $INPUT"
                    STATUS=1
                fi
            elif cp -n --preserve=timestamps -- "$INPUT" "$OUTPUT"; then
                color_line 32 "✔  Copied: $INPUT → $OUTPUT"
            else
                color_line 31 "✘  Copy failed: $INPUT"
                STATUS=1
            fi
            continue
            ;;
    esac

    ALL_CONVERTED=true
    for FORMAT in "${FORMATS[@]}"; do
        if [[ "$FORMAT" == h265 ]]; then
            OUTPUT="./H265/${NAME}_h265.MP4"
            VIDEO_OPTIONS=(
                -c:v hevc_nvenc -profile:v main10 -preset "$H265_PRESET"
                -rc vbr -cq "$H265_CQ" -b:v 0
                -g 60 -bf 3 -tag:v hvc1
            )
        else
            OUTPUT="./AV1/${NAME}_av1.MP4"
            VIDEO_OPTIONS=(
                -c:v av1_nvenc -preset "$AV1_PRESET"
                -rc vbr -cq "$CQ" -b:v 0
            )
        fi

        if [[ -e "$OUTPUT" ]]; then
            color_line 33 "⚠  Output already exists, skipping: $OUTPUT"
            ALL_CONVERTED=false
            continue
        fi

        color_line 36 "▶  Encoding: $INPUT"
        color_line 36 "   → $OUTPUT"

        TEMP_DIR="$(mktemp -d "${OUTPUT%/*}/.process_dji.XXXXXX")"
        TEMP_OUTPUT="$TEMP_DIR/output.MP4"

        if ffmpeg -hide_banner -loglevel error -stats -nostdin -n \
            -hwaccel cuda -hwaccel_output_format cuda \
            -i "$INPUT" \
            -map 0:v:0 \
            -vf "scale_cuda=format=p010le" \
            "${VIDEO_OPTIONS[@]}" \
            -an -map_metadata 0 -movflags +faststart \
            "$TEMP_OUTPUT"; then
            # Publish atomically without overwriting an output created meanwhile.
            if ln -- "$TEMP_OUTPUT" "$OUTPUT"; then
                color_line 32 "✔  Done: $OUTPUT"
            else
                color_line 31 "✘  Could not publish output: $OUTPUT"
                ALL_CONVERTED=false
                STATUS=1
            fi
        else
            color_line 31 "✘  Failed: $INPUT ($FORMAT)"
            ALL_CONVERTED=false
            STATUS=1
        fi
        cleanup
        TEMP_DIR=""

        echo ""
    done
    if [[ "$DELETE_ORIGINALS" == true && "$ALL_CONVERTED" == true ]]; then
        if rm -- "$INPUT"; then
            color_line 32 "✔  Deleted original: $INPUT"
        else
            color_line 31 "✘  Could not delete original: $INPUT"
            STATUS=1
        fi
    fi
done

exit "$STATUS"
