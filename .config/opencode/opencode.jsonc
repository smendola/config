{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "lsp": true,
  "enabled_providers": [
    "zai",
    "deepseek",
    "mimimax",
    "openai",
    "llama-server"
  ],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 15000
  },
  "provider": {
    "zai": {
      "options": {
        "apiKey": "{env:ZAI_GLM_KEY}"
      }
    },
    "deepseek": {
      "options": {
        "baseURL": "https://api.deepseek.com",
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      }
    },
    "llama-server": {
      "name": "llama-server cuda-linux:8080",
      "models": {
        "ornith-1.5-35b/a3b-think": {
          "name": "Ornith 1.5 35B/A3B Think [200k]",
          "limit": {
            "context": 200000,
            "output": 8192
          }
        },
        "qwen3.6-35b/a3b-think": {
          "name": "Qwen3.6 35B/A3B Think [260k]",
          "limit": {
            "context": 260000,
            "output": 8192
          }
        },
        "qwen3.5-9b-mtp-think": {
          "name": "Qwen3.5 9B Mtp Think [262k]",
          "limit": {
            "context": 262144,
            "output": 8192
          }
        },
        "gemma4-26b/a4b-think": {
          "name": "Gemma4 26B/A4B Think [120k]",
          "limit": {
            "context": 120000,
            "output": 8192
          }
        },
        "kimi-vl-a3b-think": {
          "name": "Kimi Vl A3B Think [131k]",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        },
        "glm4.7-30b-a3b-q3-think": {
          "name": "Glm4.7 30B A3B Q3 Think [128k]",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "glm4.7-30b-a3b-q5-think": {
          "name": "Glm4.7 30B A3B Q5 Think [128k]",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "glm4.7-30b-a3b-iq4-think": {
          "name": "Glm4.7 30B A3B Iq4 Think [128k]",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "qwen3.8-q4-think": {
          "name": "Qwen3.8 Q4 Think [100k]",
          "limit": {
            "context": 100000,
            "output": 8192
          }
        },
        "qwen3.8-iq2": {
          "name": "Qwen3.8 Iq2 [160k]",
          "limit": {
            "context": 160000,
            "output": 8192
          }
        },
        "qwen3.8-iq2-think": {
          "name": "Qwen3.8 Iq2 Think [160k]",
          "limit": {
            "context": 160000,
            "output": 8192
          }
        },
        "qwen3.8-iq3-think": {
          "name": "Qwen3.8 Iq3 Think [64k]",
          "limit": {
            "context": 64000,
            "output": 8192
          }
        },
        "dirk-qwen3.8-iq4-think": {
          "name": "Dirk Qwen3.8 Iq4 Think [64k]",
          "limit": {
            "context": 64000,
            "output": 8192
          }
        }
      },
      "options": {
        "baseURL": "http://cuda-linux:8080/v1",
        "apiKey": "not.needed"
      }
    }
  },
  "mcp": {
    "asana": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.asana.com/v2/mcp",
      "oauth": {
        "clientId": "{env:ASANA_CLIENT_ID}",
        "clientSecret": "{env:ASANA_CLIENT_SECRET}",
        "redirectUri": "http://localhost:19876/mcp/oauth/callback"
      }
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp"
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer {env:CONTEXT7_API_KEY}"
      }
    },
    "freecad": {
      "type": "local",
      "command": [
        "/home/sal/miniconda3/bin/freecad-mcp"
      ],
      "environment": {
        "FREECAD_MODE": "xmlrpc",
        "FREECAD_SOCKET_HOST": "localhost",
        "FREECAD_XMLRPC_PORT": "9875"
      }
    }
  },
  "plugin": [
    "/home/sal/repos/ponytail/.opencode/plugins/ponytail.mjs"
  ],
  "keybinds": {
    "diff_open": "<leader>d"
  }
}
