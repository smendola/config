{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "lsp": true,
  "enabled_providers": [
    "zai",
    "deepseek",
    "minimax",
    "openai",
    "llama-server",
    "strata"
  ],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 15000
  },
  "provider": {
    "zai": {
      "options": {
        "apiKey": "{env:ZAI_GLM_KEY}"
      }
    },
    "deepseek": {
      "options": {
        "baseURL": "https://api.deepseek.com",
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      }
    },
    "llama-server": {
      "name": "llama-server cuda-linux:8080",
      "models": {
        "qwen3.6-35b/a3b-think": {
          "name": "Qwen3.6 35B/A3B Think [260k]",
          "limit": {
            "context": 260000,
            "output": 8192
          }
        },
        "kimi-vl-a3b-think": {
          "name": "Kimi Vl A3B Think [131k]",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        },
        "glm4.7-30b-a3b-q3-think": {
          "name": "Glm4.7 30B A3B Q3 Think [128k]",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "glm4.7-30b-a3b-q5-think": {
          "name": "Glm4.7 30B A3B Q5 Think [128k]",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "glm4.7-30b-a3b-iq4-think": {
          "name": "Glm4.7 30B A3B Iq4 Think [128k]",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "qwen3.8-27b-q4-think": {
          "name": "Qwen3.8 27B Q4 Think [100k]",
          "limit": {
            "context": 100000,
            "output": 8192
          }
        },
        "qwen3.8-27b-iq3-140-think": {
          "name": "Qwen3.8 27B Iq3 140 Think [140k]",
          "limit": {
            "context": 140000,
            "output": 8192
          }
        },
        "qwen3.8-27b-iq4-think": {
          "name": "Qwen3.8 27B Iq4 Think [100k]",
          "limit": {
            "context": 100000,
            "output": 8192
          }
        },
        "qwen3.8-27b-iq3-gsq-rco-think": {
          "name": "Qwen3.8 27B Iq3 Gsq Rco Think [100k]",
          "limit": {
            "context": 100000,
            "output": 8192
          }
        },
        "qwen3.8-27b-iq3-gsq-rco-200-vision-think": {
          "name": "Qwen3.8 27B Iq3 Gsq Rco 200 Vision Think 👁️‍🗨️ [200k]",
          "limit": {
            "context": 200000,
            "output": 8192
          },
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      },
      "options": {
        "baseURL": "http://cuda-linux:8080/v1",
        "apiKey": "not.needed"
      }
    }
  },
  "providers": {
    "strata": {
      "name": "(Poly)Strata :9090",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:9090/v1"
      },
      "compatibility": {
        "maxTokensField": "max_tokens",
        "reasoningField": "reasoning_content"
      },
      "models": {
        "qwen3.6-35b-a3b-ud-q4_k_m": {
          "name": "Qwen3.6 35B/A3B UD Q4_K_M 👁️‍🗨️ [262k]",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 262144,
            "output": 8192
          }
        },
        "qwen3.8-flash-next-coder-iq1_m": {
          "name": "Qwen3.8 Flash Next Coder 👁️‍🗨️ [131k]",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 131072,
            "output": 8192
          }
        },
        "swift-1.5-iq3_s": {
          "name": "Swift1.5 IQ3_S 👁️‍🗨️ [205k]",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 204800,
            "output": 8192
          }
        }
      }
    }
  },
  "mcp": {
    "chrome-devtools": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@1.12.0",
        "--autoConnect",
        "--no-usage-statistics",
        "--no-performance-crux"
      ]
    },
    "asana": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.asana.com/v2/mcp",
      "oauth": {
        "clientId": "{env:ASANA_CLIENT_ID}",
        "clientSecret": "{env:ASANA_CLIENT_SECRET}",
        "redirectUri": "http://localhost:19876/mcp/oauth/callback"
      }
    },
    "sentry": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp"
    },
    "postman": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.postman.com/minimal"
    },
    "context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer {env:CONTEXT7_API_KEY}"
      }
    },
    "sendgrid": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "sendgrid-mcp"
      ],
      "environment": {
        "SENDGRID_API_KEY": "{env:SENDGRID_API_KEY}",
        "READ_ONLY": "false",
        "REQUEST_TIMEOUT": "60000"
      }
    },
    "freecad": {
      "enabled": false,
      "type": "local",
      "command": [
        "/usr/bin/env",
        "-C",
        "/tmp/opencode",
        "/home/sal/miniconda3/bin/freecad-mcp"
      ],
      "environment": {
        "FREECAD_MODE": "xmlrpc",
        "FREECAD_SOCKET_HOST": "localhost",
        "FREECAD_XMLRPC_PORT": "9875"
      }
    },
    "solidcraft": {
      "enabled": true,
      "type": "local",
      "command": [
        "/home/sal/.local/bin/solidcraft-cli",
        "mcp",
        "--allow-any-path"
      ]
    },
    "servers": {
      "firefox-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@mozilla/firefox-devtools-mcp@latest"
        ],
        "disabled": false
      },
      "onshape-featurescript": {
        "type": "remote",
        "url": "https://fs-mcp.labs.onshape.app/mcp"
      }
    }
  },
  "plugin": [],
  "keybinds": {
    "diff_open": "<leader>d"
  }
}
